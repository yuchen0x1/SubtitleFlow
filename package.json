{
  "name": "subtitleflow",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config apps/extension/vite.config.ts",
    "postbuild": "node scripts/fix-extension-build.mjs",
    "dev": "vite --config apps/extension/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/extension/tsconfig.json --noEmit",
    "package": "npm run build && npm run pack:dist",
    "pack:dist": "python scripts/package-extension.py",
    "check:env": "powershell -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "local-service": "powershell -ExecutionPolicy Bypass -File scripts/start-local-service.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
